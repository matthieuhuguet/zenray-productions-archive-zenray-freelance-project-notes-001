    </label>
    <label class="ctrl-group">
      <span>Nombres (GT Ultra)</span>
      <input id="ctrl-num-scale" type="range" min="90" max="115" step="1" value="100">
      <output id="out-num-scale">100%</output>
    </label>
    <button type="button" class="btn-action primary" id="btn-copy">Copier les valeurs pour le prompt</button>
    <span id="copy-status" role="status"></span>
  </div>
</header>

<main class="workspace">
  <section class="stage-card" aria-label="Aperçu interactif pixel-perfect">
    <div class="stage-head">
      <div class="variant-tabs" role="tablist">
        <button type="button" class="variant-tab" role="tab" data-variant="free" aria-selected="true">A · Casse libre GT Ultra (défaut <span class="num">26 October 2026</span>)</button>
        <button type="button" class="variant-tab" role="tab" data-variant="upper" aria-selected="false">B · Capitales GT Ultra (ZENRAY FREELANCE)</button>
        <button type="button" class="variant-tab" role="tab" data-variant="mixed" aria-selected="false">C · Titre libre GT Ultra + sections capitales</button>
      </div>
      <span>Géométrie, espacements et composants <span class="num">100%</span> identiques à la production · Seules les <span class="num">3</span> polices changent</span>
    </div>
    <div class="stage-frame-wrap">
      <iframe id="live-frame" title="ZenRay Freelance Pixel-Perfect"></iframe>
    </div>
  </section>

  <section class="compare-grid" id="compare-grid" aria-label="Comparaison des trois réglages de casse et des thèmes"></section>
</main>

