// Regex that matches numbers and indivisible date/time/unit expressions per Typography1.md (26 October 2026):
// - Dates: "12 octobre 2026", "11 décembre 2026", "20 avril 2027", "1 juillet 2026", "26 October 2026"
// - Durations & units attached to numbers: "2 h", "4 h", "18 h", "6 h", "17 s", "34 min", "8-months", "+20 pts"
// - Standalone numbers & scores: "770", "41", "01", "89", "2027", etc.
const NUM_UNIT_REGEX = /([+-]?\d+(?:[\s.,]\d+)*(?:\s*(?:janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre|January|February|March|April|May|June|July|August|September|October|November|December)(?:\s+\d{4})?|\s*-\s*months|\s*(?:min|pts?|h|s|j|%|€))?)/gi;

function buildFreelanceDocument(variantId, theme, customParams = {}) {
  const v = VARIANTS.find(x => x.id === variantId) || VARIANTS[0];
  const rawHtml = theme === 'light' ? SNAPSHOT.htmlLight : SNAPSHOT.htmlDark;
  const doc = new DOMParser().parseFromString(rawHtml, 'text/html');

  // 1. Tag main h1 and section titles so we can style them cleanly via CSS variables
  const h1 = doc.querySelector('h1');
  if (h1) h1.classList.add('zr-fl-main-title');

  // Section titles (Lot du jour, etc.) and tab buttons (À contacter, Suivi, Périmées)
  doc.querySelectorAll('span, div, h2, h3').forEach(el => {
    const style = el.getAttribute('style') || '';
    if (style.includes('--fl-font-title') && el !== h1) {
      el.classList.add('zr-fl-sec-title');
    }
    if (style.includes('--fl-font-body')) {
      el.classList.add('zr-fl-body-text');
    }
  });

  // Also check the 3 tab labels below Lot du jour: "À contacter", "Suivi", "Périmées"
  doc.querySelectorAll('button').forEach(btn => {
    const firstSpan = btn.querySelector('span');
    if (firstSpan && ['À contacter', 'Suivi', 'Périmées'].includes(firstSpan.textContent.trim())) {
      firstSpan.classList.add('zr-fl-sec-title');
    }
  });

  // 2. Wrap every number, date, duration, and score in <span class="zr-num"> so GT Ultra 400 applies everywhere,
  // excluding "ToDo-3D" in the left sidebar which is a folder name.
  const walker = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
  const textNodes = [];
  while (walker.nextNode()) textNodes.push(walker.currentNode);

  for (const node of textNodes) {
    const parent = node.parentElement;
    if (!parent) continue;
    if (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE') continue;
    const txt = node.nodeValue;
    if (!/\d/.test(txt)) continue;
    if (txt.trim() === 'ToDo-3D') continue;

    // If the entire parent is already solely a number (like badge or score), mark parent and wrap
    const replaced = txt.replace(NUM_UNIT_REGEX, '<span class="zr-num">$1</span>');
    if (replaced !== txt) {
      const wrapper = doc.createElement('span');
      wrapper.innerHTML = replaced;
      node.replaceWith(...wrapper.childNodes);
    }
  }

  const titleSize = customParams.titleSize ?? v.titleSize;
  const titleTrack = customParams.titleTrack ?? v.titleTrack;
  const bodySize = customParams.bodySize ?? 15;
  const numScale = customParams.numScale ?? 100;

  const overrideCss = `
    :root {
      --font-title: 'GT Ultra', 'Hiragino Sans W4', sans-serif;
      --font-num: 'GT Ultra', 'Hiragino Sans W4', sans-serif;
      --font-body: 'Literata', 'Hiragino Mincho ProN W3', Georgia, serif;
      --font-ui: 'GT Standard L', 'Hiragino Sans W4', sans-serif;
      --hda-title-size: ${titleSize}px;
      --hda-title-case: ${v.titleCase};
      --hda-title-track: ${titleTrack};
      --hda-sec-case: ${v.secCase};
      --hda-sec-track: ${v.secTrack};
      --hda-sec-size: ${v.secSize};
      --hda-body-size: ${bodySize}px;
      --hda-num-scale: ${numScale}%;
    }
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
      background: ${theme === 'light' ? '#eceae3' : '#141413'};
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url('${WALL_URL}');
      background-size: cover;
      background-position: center;
      z-index: -2;
      filter: ${theme === 'light' ? 'saturate(0.85) brightness(1.02)' : 'saturate(0.75) brightness(0.32)'};
    }
    .zr-paper {
      --fl-font-title: var(--font-title) !important;
      --fl-font-num: var(--font-num) !important;
      --fl-font-body: var(--font-body) !important;
      --fl-font-ui: var(--font-ui) !important;
      --fl-title-weight: 400 !important;
      --fl-title-style: normal !important;
      --fl-title-case: var(--hda-title-case) !important;
      --fl-title-track: var(--hda-title-track) !important;
      --fl-num-weight: 400 !important;
      --zr-police-sans: var(--font-ui) !important;
      --zr-police-serif: var(--font-title) !important;
      --zr-police-mono: var(--font-num) !important;
    }
    /* 1. GT Ultra Regular 400 on Titles */
    .zr-fl-main-title {
      font-family: var(--font-title) !important;
      font-weight: 400 !important;
      font-style: normal !important;
      font-size: var(--hda-title-size) !important;
      text-transform: var(--hda-title-case) !important;
      letter-spacing: var(--hda-title-track) !important;
    }
    .zr-fl-sec-title {
      font-family: var(--font-title) !important;
      font-weight: 400 !important;
      font-style: normal !important;
      font-size: var(--hda-sec-size) !important;
      text-transform: var(--hda-sec-case) !important;
      letter-spacing: var(--hda-sec-track) !important;
    }
    /* 2. GT Ultra Regular 400 on ALL Numbers, Dates, Times, Scores, Durations */
    .zr-num {
      font-family: var(--font-num) !important;
      font-weight: 400 !important;
      font-style: normal !important;
      font-variant-numeric: tabular-nums !important;
      font-size: var(--hda-num-scale) !important;
    }
    /* 3. Literata 400/500 on Studio Names, Job Roles, and Sidebar Zone Headings */
    .zr-fl-body-text {
      font-family: var(--font-body) !important;
    }
    .zr-ws-sidebar .zr-ws-heading {
      font-family: var(--font-body) !important;
      font-style: italic !important;
      font-weight: 500 !important;
    }
    /* 4. GT Standard L 400 on all UI chrome and sidebar items */
    .zr-ws-sidebar .zr-ws-item,
    .zr-sbs-search input {
      font-family: var(--font-ui) !important;
      font-weight: 400 !important;
    }
  `;

  return `<!doctype html><html lang="fr" data-variant="${v.id}" data-theme="${theme}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>${SNAPSHOT.css.join('\n')}\n${IFRAME_FONT_CSS}\n${overrideCss}</style></head><body>${doc.body.innerHTML}</body></html>`;
}

const liveFrame = document.getElementById('live-frame');
const ctrlCase = document.getElementById('ctrl-case');
const ctrlTheme = document.getElementById('ctrl-theme');
const ctrlTitleSize = document.getElementById('ctrl-title-size');
const ctrlTitleTrack = document.getElementById('ctrl-title-track');
const ctrlBodySize = document.getElementById('ctrl-body-size');
const ctrlNumScale = document.getElementById('ctrl-num-scale');

function getParams() {
  return {
    variant: ctrlCase.value,
    theme: ctrlTheme.value,
    titleSize: Number(ctrlTitleSize.value),
    titleTrack: ctrlTitleTrack.value + 'em',
    bodySize: Number(ctrlBodySize.value),
    numScale: Number(ctrlNumScale.value),
  };
}

function renderLive() {
  const p = getParams();
  document.documentElement.dataset.pageTheme = p.theme;
  document.getElementById('out-title-size').textContent = p.titleSize + 'px';
  document.getElementById('out-title-track').textContent = p.titleTrack;
  document.getElementById('out-body-size').textContent = p.bodySize + 'px';
  document.getElementById('out-num-scale').textContent = p.numScale + '%';

  document.querySelectorAll('.variant-tab').forEach(btn => {
    btn.setAttribute('aria-selected', String(btn.dataset.variant === p.variant));
  });

  liveFrame.srcdoc = buildFreelanceDocument(p.variant, p.theme, p);
}

function updateLiveVarsOnly() {
  const p = getParams();
  document.getElementById('out-title-size').textContent = p.titleSize + 'px';
  document.getElementById('out-title-track').textContent = p.titleTrack;
  document.getElementById('out-body-size').textContent = p.bodySize + 'px';
  document.getElementById('out-num-scale').textContent = p.numScale + '%';

  const root = liveFrame.contentDocument?.documentElement;
  if (!root) return;
  root.style.setProperty('--hda-title-size', p.titleSize + 'px');
  root.style.setProperty('--hda-title-track', p.titleTrack);
  root.style.setProperty('--hda-body-size', p.bodySize + 'px');
  root.style.setProperty('--hda-num-scale', p.numScale + '%');
  // Apply bodySize to studio names inside apply list and cards
  liveFrame.contentDocument.querySelectorAll('.zr-fl-body-text').forEach(el => {
    if (el.tagName === 'STRONG' || el.style.fontWeight === '600' || el.style.fontWeight === '500') {
      el.style.fontSize = p.bodySize + 'px';
    }
  });
}

ctrlCase.addEventListener('change', () => {
  const v = VARIANTS.find(x => x.id === ctrlCase.value) || VARIANTS[0];
  ctrlTitleSize.value = v.titleSize;
  ctrlTitleTrack.value = parseFloat(v.titleTrack) || 0;
  renderLive();
});
ctrlTheme.addEventListener('change', renderLive);
[ctrlTitleSize, ctrlTitleTrack, ctrlBodySize, ctrlNumScale].forEach(input => {
  input.addEventListener('input', updateLiveVarsOnly);
});

document.querySelectorAll('.variant-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    ctrlCase.value = btn.dataset.variant;
    const v = VARIANTS.find(x => x.id === ctrlCase.value) || VARIANTS[0];
    ctrlTitleSize.value = v.titleSize;
    ctrlTitleTrack.value = parseFloat(v.titleTrack) || 0;
    renderLive();
  });
});

document.getElementById('btn-copy').addEventListener('click', async () => {
  const p = getParams();
  const payload = JSON.stringify({
    module: 'ZenRay Freelance',
    fonts: {
      title: 'GT Ultra 400',
      numbers: 'GT Ultra 400',
      body: 'Literata 400/500',
      ui: 'GT Standard L 400',
    },
    ...p,
  }, null, 2);
  try {
    await navigator.clipboard.writeText(payload);
    document.getElementById('copy-status').textContent = 'Copié';
  } catch {
    const area = document.createElement('textarea');
    area.value = payload;
    document.body.append(area);
    area.select();
    document.execCommand('copy');
    area.remove();
    document.getElementById('copy-status').textContent = 'Copié';
  }
});

// Build comparison cards below (A Dark, B Dark, A Light)
const compareGrid = document.getElementById('compare-grid');
const COMPARE_CARDS = [
  { variant: 'free', theme: 'dark', label: 'A · Casse libre GT Ultra (Sombre)' },
  { variant: 'upper', theme: 'dark', label: 'B · Capitales GT Ultra (Sombre)' },
  { variant: 'free', theme: 'light', label: 'C · Casse libre GT Ultra (Clair papier)' },
];

COMPARE_CARDS.forEach(c => {
  const v = VARIANTS.find(x => x.id === c.variant);
  const card = document.createElement('article');
  card.className = 'compare-card';
  card.innerHTML = `
    <div class="compare-card-head">
      <div>
        <h2>${c.label}</h2>
        <p>${v.desc}</p>
      </div>
    </div>
    <div class="compare-shot"><iframe tabindex="-1" title="${c.label}"></iframe></div>
    <div class="compare-foot">
      <span>GT Ultra · Literata · GT Standard L</span>
      <button type="button" class="btn-action">Charger en haut ↑</button>
    </div>
  `;
  card.querySelector('iframe').srcdoc = buildFreelanceDocument(c.variant, c.theme);
  card.querySelector('button').addEventListener('click', () => {
    ctrlCase.value = c.variant;
    ctrlTheme.value = c.theme;
    ctrlTitleSize.value = v.titleSize;
    ctrlTitleTrack.value = parseFloat(v.titleTrack) || 0;
    renderLive();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  compareGrid.append(card);
});

function scaleCompareShots() {
  document.querySelectorAll('.compare-shot').forEach(box => {
    const scale = box.clientWidth / 1512;
    const frame = box.querySelector('iframe');
    if (frame) frame.style.transform = `scale(${scale})`;
    box.style.height = Math.round(945 * scale) + 'px';
  });
}
window.addEventListener('resize', scaleCompareShots);
scaleCompareShots();

window.openFreelanceVariant = (variant, theme) => {
  ctrlCase.value = variant;
  ctrlTheme.value = theme;
  const v = VARIANTS.find(x => x.id === variant) || VARIANTS[0];
  ctrlTitleSize.value = v.titleSize;
  ctrlTitleTrack.value = parseFloat(v.titleTrack) || 0;
  renderLive();
};

// Initial render: Variant A (free case GT Ultra per 15:10 rule) in Dark mode (matching screenshot)
ctrlCase.value = 'free';
ctrlTheme.value = 'dark';
ctrlTitleTrack.value = -0.01;
renderLive();
</script>
</body>
</html>
