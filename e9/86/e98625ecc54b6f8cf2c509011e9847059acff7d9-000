:root {
  --font-title: 'GT Ultra', 'Hiragino Sans W4', sans-serif;
  --font-num: 'GT Ultra', 'Hiragino Sans W4', sans-serif;
  --font-body: 'Literata', 'Hiragino Mincho ProN W3', Georgia, serif;
  --font-ui: 'GT Standard L', 'Hiragino Sans W4', sans-serif;
  --bg: #171614;
  --surface: #211f1c;
  --card: #282622;
  --line: #3b3833;
  --ink: #eceae4;
  --muted: #a6a095;
  --accent: #d97757;
}
:root[data-page-theme="light"] {
  --bg: #f3f1eb;
  --surface: #faf8f3;
  --card: #ffffff;
  --line: #dcd8ce;
  --ink: #22201c;
  --muted: #666157;
  --accent: #b85c3c;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 400 14px/1.45 var(--font-ui);
}
button, select, input { font: inherit; color: inherit; }
button { cursor: pointer; }
h1, h2, h3, p { margin: 0; }
.num {
  font-family: var(--font-num);
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  background: color-mix(in srgb, var(--surface) 92%, transparent);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.brand-block {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-right: 8px;
}
.brand-title {
  font-family: var(--font-title);
  font-weight: 400;
  font-size: 20px;
  letter-spacing: -0.01em;
}
.brand-sub {
  font-size: 12px;
  color: var(--muted);
}
.font-pills {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.font-pill {
  font-size: 11.5px;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--muted);
}
.font-pill strong {
  color: var(--ink);
  font-weight: 400;
}
.font-pill.f-ultra strong { font-family: var(--font-title); }
.font-pill.f-literata strong { font-family: var(--font-body); }
.font-pill.f-standard strong { font-family: var(--font-ui); }

.hda-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-left: auto;
}
.ctrl-group {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 5px 10px;
}
.ctrl-group select {
  background: transparent;
  border: none;
  color: var(--ink);
  font-size: 12px;
  outline: none;
}
.ctrl-group input[type="range"] {
  width: 72px;
  accent-color: var(--accent);
}
.ctrl-group output {
  font-family: var(--font-num);
  color: var(--ink);
  min-width: 28px;
  text-align: right;
}
.btn-action {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  transition: background 150ms, border-color 150ms;
}
.btn-action:hover {
  border-color: var(--ink);
}
.btn-action.primary {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}
#copy-status {
  font-size: 12px;
  color: var(--accent);
}

.workspace {
  padding: 18px 24px 36px;
  max-width: 1640px;
  margin: 0 auto;
}
.stage-card {
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  background: #141413;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
}
.stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
  font-size: 12px;
  color: var(--muted);
  gap: 12px;
  flex-wrap: wrap;
}
.variant-tabs {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.variant-tab {
  padding: 5px 12px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--muted);
  font-size: 12px;
}
.variant-tab[aria-selected="true"] {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}
.stage-frame-wrap {
  width: 100%;
  height: 920px;
  position: relative;
  background: #141413;
}
iframe#live-frame {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
}

.compare-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}
.compare-card {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.compare-card-head {
  padding: 14px 16px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
}
.compare-card-head h2 {
  font-family: var(--font-title);
  font-weight: 400;
  font-size: 18px;
}
.compare-card-head p {
  font-family: var(--font-body);
  font-size: 12.5px;
  color: var(--muted);
  margin-top: 4px;
}
.compare-shot {
  position: relative;
  overflow: hidden;
  background: #141413;
  height: 310px;
}
.compare-shot iframe {
  width: 1512px;
  height: 945px;
  border: 0;
  transform-origin: top left;
  pointer-events: none;
}
.compare-foot {
  padding: 10px 14px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: var(--muted);
}

@media (max-width: 1100px) {
  .compare-grid { grid-template-columns: 1fr; }
}
</style>
</head>
