<header class="topbar">
  <div class="brand-block">
    <span class="brand-title">ZenRay Freelance</span>
    <span class="brand-sub">Pixel-perfect · <span class="num">26 October 2026</span></span>
  </div>
  <div class="font-pills">
    <span class="font-pill f-ultra"><strong>GT Ultra <span class="num">400</span></strong> · Titres et tous les nombres</span>
    <span class="font-pill f-literata"><strong>Literata <span class="num">400</span></strong> · Studios, postes, sections sidebar</span>
    <span class="font-pill f-standard"><strong>GT Standard L <span class="num">400</span></strong> · Interface et boutons</span>
  </div>
  <div class="hda-controls">
    <label class="ctrl-group">
      <span>Casse titres</span>
      <select id="ctrl-case" aria-label="Casse des titres">
        <option value="free">A · Casse libre (ZenRay Freelance)</option>
        <option value="upper">B · Capitales (ZENRAY FREELANCE)</option>
        <option value="mixed">C · Titre libre + sections capitales</option>
      </select>
    </label>
    <label class="ctrl-group">
      <span>Thème</span>
      <select id="ctrl-theme" aria-label="Thème">
        <option value="dark">Sombre (actuel)</option>
        <option value="light">Clair (papier)</option>
      </select>
    </label>
    <label class="ctrl-group">
      <span>Titre</span>
      <input id="ctrl-title-size" type="range" min="24" max="42" step="1" value="30">
      <output id="out-title-size">30px</output>
    </label>
    <label class="ctrl-group">
      <span>Approche</span>
      <input id="ctrl-title-track" type="range" min="-0.04" max="0.10" step="0.005" value="0">
