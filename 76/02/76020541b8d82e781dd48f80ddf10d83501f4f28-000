    function renderAll() {
      const exp = EXPERIENCES[currentExpId][currentLang];
      document.getElementById('lang-en').classList.toggle('active', currentLang === 'en');
      document.getElementById('lang-fr').classList.toggle('active', currentLang === 'fr');

      ['meerkat', 'zenray', 'noyes', 'education'].forEach(id => {
        document.getElementById('tab-' + id).classList.toggle('active', id === currentExpId);
      });

      document.getElementById('inp-title').value = exp.title;
      document.getElementById('inp-company').value = exp.company;
      document.getElementById('inp-location').value = exp.location;
      document.getElementById('inp-from').value = exp.fromSlash;
      document.getElementById('inp-to').value = exp.toSlash;
      document.getElementById('inp-desc').value = exp.description;

      document.getElementById('btn-from-text').textContent = exp.fromText;
      document.getElementById('btn-from-slash').textContent = 'Copier ' + exp.fromSlash;
      document.getElementById('btn-to-text').textContent = exp.toText;
      document.getElementById('btn-to-slash').textContent = 'Copier ' + exp.toSlash;
      document.getElementById('lbl-duration').textContent = exp.duration;
      document.getElementById('exp-period-badge').textContent = exp.fromText + ' à ' + exp.toText + ' · ' + exp.duration;

      const letData = LETTERS[currentLang];
      document.getElementById('inp-subject').value = letData.subject;
      document.getElementById('inp-letter').value = letData.text;
      document.getElementById('btn-swap-lang').textContent = currentLang === 'fr' ? 'Version anglaise' : 'Version française';
    }

    function setLanguage(lang) {
      currentLang = lang;
      renderAll();
    }

    function toggleLanguage() {
      setLanguage(currentLang === 'fr' ? 'en' : 'fr');
    }

    function selectExp(id) {
      currentExpId = id;
      renderAll();
    }

    function flashBtn(btnId) {
      const el = document.getElementById(btnId);
      if (!el) return;
      const prev = el.textContent;
      el.classList.add('copied');
      el.textContent = 'Copié ✓';
      setTimeout(() => {
        el.classList.remove('copied');
        renderAll();
      }, 1200);
    }

    function copyInput(inputId, btnId) {
      const val = document.getElementById(inputId).value;
      navigator.clipboard.writeText(val);
      flashBtn(btnId);
    }

    function copyField(fieldKey, btnId) {
      const val = EXPERIENCES[currentExpId][currentLang][fieldKey];
      navigator.clipboard.writeText(val);
      flashBtn(btnId);
    }

    function copyAllExp() {
      const exp = EXPERIENCES[currentExpId][currentLang];
      const bundle = `${exp.title} · ${exp.company}\n${exp.location}\n${exp.fromText} (${exp.fromSlash}) - ${exp.toText} (${exp.toSlash}) · ${exp.duration}\n\n${exp.description}`;
      navigator.clipboard.writeText(bundle);
      flashBtn('btn-copy-all');
    }

    function toggleTheme() {
      const root = document.documentElement;
      root.setAttribute('data-theme', root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    }

    function setHda(varName, val, labelId, labelText) {
      document.documentElement.style.setProperty(varName, val);
      document.getElementById(labelId).textContent = labelText;
    }

    function copyHdaParams() {
      const cs = getComputedStyle(document.documentElement);
      const payload = [
        `--hda-body-size: ${cs.getPropertyValue('--hda-body-size').trim()}`,
        `--hda-line-height: ${cs.getPropertyValue('--hda-line-height').trim()}`,
        `--hda-card-pad: ${cs.getPropertyValue('--hda-card-pad').trim()}`,
        `--hda-radius: ${cs.getPropertyValue('--hda-radius').trim()}`,
      ].join('; ');
      navigator.clipboard.writeText(payload);
      flashBtn('copy-hda-btn');
    }

    renderAll();
